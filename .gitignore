# ---- Build output (Maven) ----
target/
**/target/

# ---- Runtime output ----
# The app writes analysis artifacts (mp3/transcript/summary) here.
output/

# ---- Secrets ----
# Never commit real API keys. The external config/application.yml may hold the
# real key; only config/application-example.yml (the copy template) is tracked.
# The app also accepts the OPENROUTER_API_KEY env var; developers may keep their
# own copy in a local .env file.
config/application.yml
!config/application-example.yml
.env
.envrc
*.env

# ---- IDE / OS noise ----
.idea/
*.iml
.vscode/
.DS_Store
Thumbs.db

# ---- Claude Code session data ----
.claude/worktrees/

# Local Claude settings may hold API keys / machine-specific routing —
# never commit them.
.claude/settings.json
.claude/settings.local.json