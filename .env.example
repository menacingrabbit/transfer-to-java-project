# .env.example — copy how environment variables are named (not the values).
#
# The Python project loaded these from a .env file via python-dotenv.
# Spring Boot does NOT read a .env file by default — it reads real
# environment variables. So on Windows, set these in your shell:
#
#   $env:OPENROUTER_API_KEY = "sk-or-..."
#
# (PowerShell) before running the app. The app reads them through the
# OpenRouterProperties / PipelineProperties records.

# REQUIRED for any OpenRouter request. Kept out of VCS — never commit a real
# value. Validated lazily: --help and startup work even without it.
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional overrides (the code defaults are the same values below).
# NOTE: Spring binds these through relaxed binding — the env var is the SNAKE_CASE
# version of the config field (timeoutSeconds -> OPENROUTER_TIMEOUT_SECONDS).
OPENROUTER_TRANSCRIBE_MODEL=mistralai/voxtral-mini-transcribe
OPENROUTER_SUMMARISE_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_TIMEOUT_SECONDS=60.0
OPENROUTER_MAX_TOKENS=1024
OPENROUTER_CHUNK_SECONDS=590

# Optional: change where the CLI writes results (default: output)
# YT_DEFAULT_OUT_DIR=output